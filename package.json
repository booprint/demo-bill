{
  "name": "bill",
  "version": "1.0.0",
  "private": true,
  "description": "Settles orders into bills, applies tax and tips, and pushes receipts to customers.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "dev": "npm run build && node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@boos-restaurant/food-types": "file:lib/food-types",
    "avsc": "^5.7.7",
    "express": "^5.1.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
